{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "homecook.local-mac-production-rehearsal-candidate.v1",
  "title": "Homecook local Mac production rehearsal candidate",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "canonicalization", "repository", "source_ref", "release_sha", "release_tree", "ci_check_summary_digest", "ci_snapshot_digest", "ci_suite_run_set_digest", "source_manifest_digest", "compose_source_digest", "sandbox_policy_digest", "build_id", "sealed_bundle_digest", "bundle_manifest_digest", "toolchain", "build_tools", "toolchain_lock_digest", "images", "migration", "artifacts", "file_inventory", "environment_snapshot", "production_guard", "candidate_identity_digest", "manifest_digest"],
  "properties": {
    "schema": { "const": "homecook.local-mac-production-rehearsal-candidate.v1" },
    "canonicalization": { "const": "RFC8785-JCS+SHA256" },
    "repository": { "const": "netsus/homecook" },
    "source_ref": { "const": "refs/heads/master" },
    "release_sha": { "$ref": "#/$defs/sha1" },
    "release_tree": { "$ref": "#/$defs/sha1" },
    "ci_check_summary_digest": { "$ref": "#/$defs/sha256" },
    "ci_snapshot_digest": { "$ref": "#/$defs/sha256" },
    "ci_suite_run_set_digest": { "$ref": "#/$defs/sha256" },
    "source_manifest_digest": { "$ref": "#/$defs/sha256" },
    "compose_source_digest": { "$ref": "#/$defs/sha256" },
    "sandbox_policy_digest": { "$ref": "#/$defs/sha256" },
    "build_id": { "type": "string", "minLength": 1 },
    "sealed_bundle_digest": { "$ref": "#/$defs/sha256" },
    "bundle_manifest_digest": { "$ref": "#/$defs/sha256" },
    "toolchain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["node", "pnpm", "supabase_cli", "git", "gh", "docker_client", "docker_daemon", "launchctl", "lsof", "audit_log", "sandbox_exec", "candidate_builder"],
      "properties": {
        "node": { "$ref": "#/$defs/toolIdentity" },
        "pnpm": { "$ref": "#/$defs/toolIdentity" },
        "supabase_cli": { "$ref": "#/$defs/toolIdentity" },
        "git": { "$ref": "#/$defs/toolIdentity" },
        "gh": { "$ref": "#/$defs/toolIdentity" },
        "docker_client": { "$ref": "#/$defs/toolIdentity" },
        "docker_daemon": { "$ref": "#/$defs/toolIdentity" },
        "launchctl": { "$ref": "#/$defs/toolIdentity" },
        "lsof": { "$ref": "#/$defs/toolIdentity" },
        "audit_log": { "$ref": "#/$defs/toolIdentity" },
        "sandbox_exec": { "$ref": "#/$defs/toolIdentity" },
        "candidate_builder": { "$ref": "#/$defs/toolIdentity" }
      }
    },
    "toolchain_lock_digest": { "$ref": "#/$defs/sha256" },
    "build_tools": {
      "type": "object",
      "additionalProperties": false,
      "required": ["next_cli"],
      "properties": { "next_cli": { "$ref": "#/$defs/toolIdentity" } }
    },
    "images": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["service", "reference", "digest", "platform", "image_id", "local_cache_provenance_digest"],
        "properties": {
          "service": { "type": "string", "minLength": 1 },
          "reference": { "type": "string", "pattern": "^[^ @]+@sha256:[0-9a-f]{64}$" },
          "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
          "platform": { "type": "string", "minLength": 1 },
          "image_id": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
          "local_cache_provenance_digest": { "$ref": "#/$defs/sha256" }
        }
      }
    },
    "migration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ordered_migration_files", "ordered_migration_files_digest", "migration_head"],
      "properties": {
        "ordered_migration_files": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^supabase/migrations/[^/]+\\.sql$" } },
        "ordered_migration_files_digest": { "$ref": "#/$defs/sha256" },
        "migration_head": { "type": "string", "minLength": 1 }
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["app", "full_local", "worker"],
      "properties": {
        "app": { "$ref": "#/$defs/artifact" },
        "full_local": { "$ref": "#/$defs/artifact" },
        "worker": { "$ref": "#/$defs/artifact" }
      }
    },
    "file_inventory": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["component", "source_kind", "path", "type", "mode", "uid", "gid", "nlink", "device", "inode", "size", "ctime", "sha256", "symlink_target", "dereferenced_sha256"],
        "properties": {
          "component": { "enum": ["app", "full_local", "worker"] },
          "source_kind": { "enum": ["tracked_source", "generated_build", "worker_artifact", "fixture"] },
          "path": { "type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$" },
          "type": { "enum": ["file", "symlink"] },
          "mode": { "type": "integer", "minimum": 0, "maximum": 4095 },
          "uid": { "type": "string", "pattern": "^[0-9]+$" },
          "gid": { "type": "string", "pattern": "^[0-9]+$" },
          "nlink": { "const": "1" },
          "device": { "type": "string", "pattern": "^[0-9]+$" },
          "inode": { "type": "string", "pattern": "^[0-9]+$" },
          "size": { "type": "string", "pattern": "^[0-9]+$" },
          "ctime": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}T" },
          "sha256": { "$ref": "#/$defs/sha256" },
          "symlink_target": { "type": ["string", "null"] },
          "dereferenced_sha256": { "anyOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] }
        }
      }
    },
    "environment_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_allowlist_id", "opaque_source_identity_digest", "opaque_override_digest", "exposed_value_count"],
      "properties": {
        "source_allowlist_id": { "const": "homecook-release-rehearsal-build-env-v1" },
        "opaque_source_identity_digest": { "$ref": "#/$defs/sha256" },
        "opaque_override_digest": { "$ref": "#/$defs/sha256" },
        "exposed_value_count": { "const": 0 }
      }
    },
    "production_guard": {
      "type": "object",
      "additionalProperties": false,
      "required": ["snapshot_schema", "production_snapshot_pre_digest", "production_snapshot_post_digest", "equal", "mutation_attempt_count", "production_db_connection_count", "production_db_write_count"],
      "properties": {
        "snapshot_schema": { "const": "homecook.local-mac-production-surface-snapshot.v1" },
        "production_snapshot_pre_digest": { "$ref": "#/$defs/sha256" },
        "production_snapshot_post_digest": { "$ref": "#/$defs/sha256" },
        "equal": { "const": true },
        "mutation_attempt_count": { "const": 0 },
        "production_db_connection_count": { "const": 0 },
        "production_db_write_count": { "const": 0 }
      }
    },
    "candidate_identity_digest": { "$ref": "#/$defs/sha256" },
    "manifest_digest": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha1": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root", "digest"],
      "properties": { "root": { "type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$" }, "digest": { "$ref": "#/$defs/sha256" } }
    },
    "toolIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "realpath", "device", "inode", "mode", "ctime", "size", "sha256"],
      "properties": {
        "version": { "type": "string", "minLength": 1 },
        "realpath": { "type": "string", "pattern": "^/" },
        "device": { "type": "string", "pattern": "^[0-9]+$" },
        "inode": { "type": "string", "pattern": "^[0-9]+$" },
        "mode": { "type": "integer", "enum": [256, 292, 320, 365, 384, 420, 448, 493] },
        "ctime": { "type": "string", "minLength": 1 },
        "size": { "type": "string", "pattern": "^[0-9]+$" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
