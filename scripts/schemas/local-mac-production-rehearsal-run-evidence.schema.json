{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "homecook.local-mac-production-rehearsal-run-evidence.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "canonicalization", "status", "trusted_receipt",
    "candidate_identity_digest", "release_sha", "release_tree", "build_id",
    "sealed_bundle_digest", "bundle_manifest_digest", "run_id", "issued_at",
    "completed_at", "isolation", "migration", "fixtures", "runtime",
    "canaries", "network", "cleanup", "worker_rehearsal_rpc_authority", "production_guard", "threat_controls", "rehearsal_runner",
    "evidence_digest"
  ],
  "properties": {
    "schema": { "const": "homecook.local-mac-production-rehearsal-run-evidence.v1" },
    "canonicalization": { "const": "RFC8785-JCS+SHA256" },
    "status": { "const": "passed" },
    "trusted_receipt": { "const": false },
    "candidate_identity_digest": { "$ref": "#/$defs/digest" },
    "release_sha": { "$ref": "#/$defs/sha" },
    "release_tree": { "$ref": "#/$defs/sha" },
    "build_id": { "type": "string", "minLength": 1 },
    "sealed_bundle_digest": { "$ref": "#/$defs/digest" },
    "bundle_manifest_digest": { "$ref": "#/$defs/digest" },
    "run_id": { "type": "string", "format": "uuid" },
    "issued_at": { "type": "string", "format": "date-time" },
    "completed_at": { "type": "string", "format": "date-time" },
    "isolation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["docker_project_id", "container_names", "network_names", "volume_names", "db_identity", "ports", "root_identity_digest", "execution_root_identity_digest", "collision_preflight_digest", "network_ids", "container_ids", "volume_ids", "resource_identity_digest"],
      "properties": {
        "docker_project_id": { "type": "string", "pattern": "^homecook-rehearsal-" },
        "container_names": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "network_names": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "volume_names": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "db_identity": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "user", "identity_digest"],
          "properties": {
            "name": { "type": "string", "pattern": "^hc_r2_" },
            "user": { "type": "string", "pattern": "^hc_r2_user_" },
            "identity_digest": { "$ref": "#/$defs/digest" }
          }
        },
        "ports": {
          "type": "object",
          "additionalProperties": false,
          "required": ["app", "auth", "postgres", "storage"],
          "properties": {
            "app": { "$ref": "#/$defs/port" },
            "auth": { "$ref": "#/$defs/port" },
            "postgres": { "$ref": "#/$defs/port" },
            "storage": { "$ref": "#/$defs/port" }
          }
        },
        "root_identity_digest": { "$ref": "#/$defs/digest" },
        "execution_root_identity_digest": { "$ref": "#/$defs/digest" },
        "collision_preflight_digest": { "$ref": "#/$defs/digest" },
        "network_ids": { "$ref": "#/$defs/orderedIds" },
        "container_ids": { "$ref": "#/$defs/orderedIds" },
        "volume_ids": { "$ref": "#/$defs/orderedIds" },
        "resource_identity_digest": { "$ref": "#/$defs/digest" }
      }
    },
    "migration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ordered_migration_files_digest", "applied_global_ledger_digest", "global_ledger_entries", "ordered_global_ledger", "migration_head", "catalog_head", "schema_identity_digest"],
      "properties": {
        "ordered_migration_files_digest": { "$ref": "#/$defs/digest" },
        "applied_global_ledger_digest": { "$ref": "#/$defs/digest" },
        "global_ledger_entries": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["sequence", "migration_id", "migration_sha256"],
            "properties": {
              "sequence": { "type": "integer", "minimum": 1 },
              "migration_id": { "type": "string", "minLength": 1 },
              "migration_sha256": { "$ref": "#/$defs/digest" }
            }
          }
        },
        "ordered_global_ledger": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "migration_head": { "type": "string", "minLength": 1 },
        "catalog_head": { "type": "string", "minLength": 1 },
        "schema_identity_digest": { "$ref": "#/$defs/digest" }
      }
    },
    "fixtures": {
      "type": "object",
      "required": ["fixture_set_id", "fixture_set_digest", "production_derived_row_count"],
      "properties": {
        "fixture_set_id": { "type": "string", "minLength": 1 },
        "fixture_set_digest": { "$ref": "#/$defs/digest" },
        "production_derived_row_count": { "const": 0 }
      },
      "additionalProperties": false
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["app", "full_local", "worker", "foreground_supervisor"],
      "properties": {
        "app": { "allOf": [{ "$ref": "#/$defs/runtime" }, { "properties": { "component": { "const": "app" } } }] },
        "full_local": { "allOf": [{ "$ref": "#/$defs/runtime" }, { "properties": { "component": { "const": "full_local" } } }] },
        "worker": { "$ref": "#/$defs/workerRuntime" },
        "foreground_supervisor": {
          "type": "object",
          "additionalProperties": false,
          "required": ["component", "pid", "process_group_id", "child_process_groups_enforced", "launchd_used", "child_identity_digest", "timeout_policy_digest"],
          "properties": {
            "component": { "const": "foreground_supervisor" },
            "pid": { "type": "integer", "minimum": 1 },
            "process_group_id": { "type": "null" },
            "child_process_groups_enforced": { "const": true },
            "launchd_used": { "const": false },
            "child_identity_digest": { "$ref": "#/$defs/digest" },
            "timeout_policy_digest": { "$ref": "#/$defs/digest" }
          }
        }
      }
    },
    "canaries": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "prefixItems": [
        { "$ref": "#/$defs/canary", "properties": { "canary_id": { "const": "app-production-route" } } },
        { "$ref": "#/$defs/canary", "properties": { "canary_id": { "const": "cross-component-identity" } } },
        { "$ref": "#/$defs/canary", "properties": { "canary_id": { "const": "external-network-deny" } } },
        { "$ref": "#/$defs/canary", "properties": { "canary_id": { "const": "full-local-api-gateway-route" } } },
        { "$ref": "#/$defs/canary", "properties": { "canary_id": { "const": "full-local-auth-route" } } },
        { "$ref": "#/$defs/canary", "properties": { "canary_id": { "const": "full-local-postgrest-fixture" } } },
        { "$ref": "#/$defs/canary", "properties": { "canary_id": { "const": "full-local-storage-route" } } },
        { "$ref": "#/$defs/canary", "properties": { "canary_id": { "const": "worker-synthetic-job" } } }
      ],
      "items": false
    },
    "network": {
      "type": "object",
      "required": ["default_deny_policy_digest", "allowed_endpoints", "denied_attempt_count", "unexpected_successful_egress_count"],
      "properties": {
        "default_deny_policy_digest": { "$ref": "#/$defs/digest" },
        "allowed_endpoints": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "denied_attempt_count": { "type": "integer", "minimum": 1 },
        "unexpected_successful_egress_count": { "const": 0 }
      },
      "additionalProperties": false
    },
    "cleanup": {
      "type": "object",
      "required": ["completed", "owned_resource_ids", "removed_resource_ids", "residue_resource_ids", "cleanup_errors", "secret_bearing_persistent_file_count"],
      "properties": {
        "completed": { "const": true },
        "owned_resource_ids": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "removed_resource_ids": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "residue_resource_ids": { "type": "array", "maxItems": 0 },
        "cleanup_errors": { "type": "array", "maxItems": 0 },
        "secret_bearing_persistent_file_count": { "const": 0 }
      },
      "additionalProperties": false
    },
    "worker_rehearsal_rpc_authority": {
      "type": "object", "additionalProperties": false,
      "required": ["config_digest", "config_file_identity_digest", "token_reference_digest", "lifecycle_version", "fixture_identity_digest"],
      "properties": { "config_digest": { "$ref": "#/$defs/digest" }, "config_file_identity_digest": { "$ref": "#/$defs/digest" }, "token_reference_digest": { "$ref": "#/$defs/digest" }, "lifecycle_version": { "type": "string", "minLength": 1 }, "fixture_identity_digest": { "$ref": "#/$defs/digest" } }
    },
    "production_guard": {
      "type": "object",
      "required": ["surface_allowlist_version", "production_snapshot_pre_digest", "production_snapshot_post_digest", "equal", "mutation_attempt_count", "production_db_connection_count", "production_db_write_count", "measurement", "measurement_digest", "independent_observer"],
      "properties": {
        "surface_allowlist_version": { "type": "string", "minLength": 1 },
        "production_snapshot_pre_digest": { "$ref": "#/$defs/digest" },
        "production_snapshot_post_digest": { "$ref": "#/$defs/digest" },
        "equal": { "const": true },
        "mutation_attempt_count": { "const": 0 },
        "production_db_connection_count": { "const": 0 },
        "production_db_write_count": { "const": 0 },
        "measurement": { "$ref": "#/$defs/productionMeasurement" },
        "measurement_digest": { "$ref": "#/$defs/digest" },
        "independent_observer": { "$ref": "#/$defs/independentObserver" }
      },
      "additionalProperties": false
    },
    "threat_controls": {
      "type": "object",
      "additionalProperties": false,
      "required": ["symlink_toctou", "namespace_collision", "digest_substitution", "stale_candidate", "cleanup_ownership"],
      "properties": {
        "symlink_toctou": { "const": "pass" },
        "namespace_collision": { "const": "pass" },
        "digest_substitution": { "const": "pass" },
        "stale_candidate": { "const": "pass" },
        "cleanup_ownership": { "const": "pass" }
      }
    },
    "rehearsal_runner": { "$ref": "#/$defs/toolIdentity" },
    "evidence_digest": { "$ref": "#/$defs/digest" }
  },
  "$defs": {
    "canary": {
        "type": "object",
        "additionalProperties": false,
        "required": ["canary_id", "started_at", "completed_at", "exit_code", "normalized_result_digest"],
        "properties": {
          "canary_id": { "type": "string", "minLength": 1 },
          "started_at": { "type": "string", "format": "date-time" },
          "completed_at": { "type": "string", "format": "date-time" },
          "exit_code": { "const": 0 },
          "normalized_result_digest": { "$ref": "#/$defs/digest" }
        }
      },
    "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "orderedIds": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "toolIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "realpath", "device", "inode", "mode", "ctime", "size", "sha256"],
      "properties": {
        "version": { "type": "string", "minLength": 1 },
        "realpath": { "type": "string", "pattern": "^/" },
        "device": { "type": "string", "pattern": "^(0|[1-9][0-9]*)$" },
        "inode": { "type": "string", "pattern": "^(0|[1-9][0-9]*)$" },
        "mode": { "enum": [256, 292, 320, 365, 384, 420, 448, 493] },
        "ctime": { "type": "string", "format": "date-time" },
        "size": { "type": "string", "pattern": "^(0|[1-9][0-9]*)$" },
        "sha256": { "$ref": "#/$defs/digest" }
      }
    },
    "port": { "type": "integer", "minimum": 20000, "maximum": 60999 },
    "productionMeasurement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "production_db_connection_count", "production_db_write_count", "mutation_attempt_count", "forbidden_mount_count", "forbidden_environment_count", "observed_container_count", "container_policy_digest", "command_policy_digest", "network_policy_digest", "external_attempt_count", "successful_egress_count", "docker_endpoint_identity_digest", "docker_daemon_identity_digest"],
      "properties": {
        "schema": { "const": "homecook.release-rehearsal-production-isolation-telemetry.v1" },
        "production_db_connection_count": { "const": 0 },
        "production_db_write_count": { "const": 0 },
        "mutation_attempt_count": { "const": 0 },
        "forbidden_mount_count": { "const": 0 },
        "forbidden_environment_count": { "const": 0 },
        "observed_container_count": { "type": "integer", "minimum": 1 },
        "container_policy_digest": { "$ref": "#/$defs/digest" },
        "command_policy_digest": { "$ref": "#/$defs/digest" },
        "network_policy_digest": { "$ref": "#/$defs/digest" },
        "external_attempt_count": { "type": "integer", "minimum": 1 },
        "successful_egress_count": { "const": 0 },
        "docker_endpoint_identity_digest": { "$ref": "#/$defs/digest" },
        "docker_daemon_identity_digest": { "$ref": "#/$defs/digest" }
      }
    },
    "independentObserver": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "source_identity_digest", "started_at", "completed_at", "pre_snapshot_digest", "post_snapshot_digest", "process_binding_digest", "docker_daemon_identity_digest", "observation_digest", "available", "truncated", "production_db_connection_count", "production_db_write_count", "production_credential_access_count", "production_socket_access_count", "provider_remote_access_count", "production_mutation_count", "unrelated_noise_count", "registered_subjects"],
      "properties": {
        "schema": { "const": "homecook.r2-production-observer.v1" },
        "source_identity_digest": { "$ref": "#/$defs/digest" },
        "started_at": { "type": "string", "format": "date-time" },
        "completed_at": { "type": "string", "format": "date-time" },
        "pre_snapshot_digest": { "$ref": "#/$defs/digest" },
        "post_snapshot_digest": { "$ref": "#/$defs/digest" },
        "process_binding_digest": { "$ref": "#/$defs/digest" },
        "docker_daemon_identity_digest": { "$ref": "#/$defs/digest" },
        "observation_digest": { "$ref": "#/$defs/digest" },
        "available": { "const": true }, "truncated": { "const": false },
        "production_db_connection_count": { "const": 0 },
        "production_db_write_count": { "const": 0 },
        "production_credential_access_count": { "const": 0 },
        "production_socket_access_count": { "const": 0 },
        "provider_remote_access_count": { "const": 0 },
        "production_mutation_count": { "const": 0 },
        "unrelated_noise_count": { "type": "integer", "minimum": 0 },
        "registered_subjects": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["container_id", "host_pid", "host_pgid", "component", "started_at", "image_digest", "config_digest", "executable_identity_digest"],
            "properties": {
              "container_id": { "type": "string", "minLength": 1 },
              "host_pid": { "type": "integer", "minimum": 1 },
              "host_pgid": { "type": "integer", "minimum": 1 },
              "component": { "enum": ["app", "full_local", "worker"] },
              "started_at": { "type": "string", "format": "date-time" },
              "image_digest": { "$ref": "#/$defs/digest" },
              "config_digest": { "$ref": "#/$defs/digest" },
              "executable_identity_digest": { "$ref": "#/$defs/digest" }
            }
          }
        }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["component", "kind", "pid", "process_group_id", "container_ids", "release_sha", "release_tree", "build_id", "sealed_bundle_digest", "migration_head", "ready", "exit_code"],
      "properties": {
        "component": { "enum": ["app", "full_local", "worker"] },
        "kind": { "const": "container" },
        "pid": { "type": "null" },
        "process_group_id": { "type": "null" },
        "container_ids": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "release_sha": { "$ref": "#/$defs/sha" },
        "release_tree": { "$ref": "#/$defs/sha" },
        "build_id": { "type": "string", "minLength": 1 },
        "sealed_bundle_digest": { "$ref": "#/$defs/digest" },
        "migration_head": { "type": "string", "minLength": 1 },
        "ready": { "const": true },
        "exit_code": { "type": "null" }
      }
    },
    "workerRuntime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["component", "kind", "pid", "process_group_id", "container_ids", "release_sha", "release_tree", "build_id", "sealed_bundle_digest", "migration_head", "ready", "exit_code", "worker_rehearsal_rpc_config_digest", "worker_rehearsal_rpc_config_identity_digest"],
      "properties": {
        "component": { "const": "worker" }, "kind": { "const": "container" }, "pid": { "type": "null" }, "process_group_id": { "type": "null" }, "container_ids": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }, "release_sha": { "$ref": "#/$defs/sha" }, "release_tree": { "$ref": "#/$defs/sha" }, "build_id": { "type": "string", "minLength": 1 }, "sealed_bundle_digest": { "$ref": "#/$defs/digest" }, "migration_head": { "type": "string", "minLength": 1 }, "ready": { "const": true }, "exit_code": { "type": "null" }, "worker_rehearsal_rpc_config_digest": { "$ref": "#/$defs/digest" }, "worker_rehearsal_rpc_config_identity_digest": { "$ref": "#/$defs/digest" }
      }
    }
  }
}
