{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "homecook.local-mac-production-release.v3",
  "title": "Homecook local Mac production release manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "repository",
    "source_ref",
    "signer_workflow",
    "signer_digest",
    "expected_release_integration_id",
    "promotion_id",
    "release_tag",
    "release_tag_object_sha",
    "release_manifest_path",
    "release_sha",
    "release_tree",
    "workflow_head_sha",
    "workflow_head_tree",
    "workflow_run_id",
    "workflow_run_attempt",
    "workflow_check_suite_id",
    "master_sha_at_approval",
    "master_tree_at_approval",
    "approved_at",
    "approved_by_task_id",
    "migration_head",
    "build_id",
    "rehearsal_receipt_schema",
    "selected_sha",
    "selected_tree",
    "observed_master_sha",
    "observed_master_tree",
    "selected_at",
    "expires_at",
    "approver_role",
    "approver_id",
    "approval_digest",
    "selection_digest",
    "sealed_bundle_digest",
    "repeatability_receipt_digest",
    "rehearsal_receipt_valid_until",
    "backup_readiness_evidence",
    "previous_release_sha",
    "expected_release_contexts",
    "required_check_summary",
    "all_check_suite_count",
    "all_check_suite_ids_digest",
    "all_check_suite_authority_digest",
    "all_actions_workflow_run_provenance_digest",
    "all_context_check_run_instances_digest",
    "all_context_check_suite_ids",
    "all_context_commit_statuses_digest",
    "attestation_digest",
    "app_launch_agent_enabled",
    "full_local_launch_agent_enabled",
    "youtube_worker_launch_agent_enabled"
  ],
  "allOf": [
    {
      "if": { "properties": { "selection_digest": { "type": "null" } } },
      "then": {
        "properties": {
          "selected_sha": { "type": "null" },
          "selected_tree": { "type": "null" },
          "observed_master_sha": { "type": "null" },
          "observed_master_tree": { "type": "null" },
          "selected_at": { "type": "null" },
          "expires_at": { "type": "null" },
          "approver_role": { "type": "null" },
          "approver_id": { "type": "null" },
          "approval_digest": { "type": "null" }
        }
      },
      "else": {
        "properties": {
          "selected_sha": { "type": "string" },
          "selected_tree": { "type": "string" },
          "observed_master_sha": { "type": "string" },
          "observed_master_tree": { "type": "string" },
          "selected_at": { "type": "string" },
          "expires_at": { "type": "string" },
          "approver_role": { "const": "human-release-approver" },
          "approver_id": { "type": "string" },
          "approval_digest": { "type": "string" }
        }
      }
    }
  ],
  "properties": {
    "schema": {
      "const": "homecook.local-mac-production-release.v3"
    },
    "repository": {
      "const": "netsus/homecook"
    },
    "source_ref": {
      "const": "refs/heads/master"
    },
    "signer_workflow": {
      "const": "netsus/homecook/.github/workflows/production-release-attestation.yml"
    },
    "signer_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "expected_release_integration_id": {
      "const": 15368
    },
    "promotion_id": {
      "type": "string",
      "minLength": 1
    },
    "release_tag": {
      "type": "string",
      "pattern": "^prod-\\d{8}\\.\\d+$"
    },
    "release_tag_object_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "release_manifest_path": {
      "type": "string",
      "minLength": 1
    },
    "release_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "release_tree": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "workflow_head_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "workflow_head_tree": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "workflow_run_id": {
      "type": "integer",
      "minimum": 1
    },
    "workflow_run_attempt": {
      "const": 1
    },
    "workflow_check_suite_id": {
      "type": "integer",
      "minimum": 1
    },
    "master_sha_at_approval": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "master_tree_at_approval": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "approved_at": {
      "type": "string",
      "format": "date-time"
    },
    "approved_by_task_id": {
      "type": "string",
      "minLength": 1
    },
    "migration_head": {
      "type": "string",
      "minLength": 1
    },
    "build_id": {
      "type": "string",
      "minLength": 1
    },
    "rehearsal_receipt_schema": {
      "const": "homecook.local-mac-production-rehearsal-repeatability-receipt.v1"
    },
    "selected_sha": {
      "oneOf": [
        { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        { "type": "null" }
      ]
    },
    "selected_tree": {
      "oneOf": [
        { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        { "type": "null" }
      ]
    },
    "observed_master_sha": {
      "oneOf": [
        { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        { "type": "null" }
      ]
    },
    "observed_master_tree": {
      "oneOf": [
        { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        { "type": "null" }
      ]
    },
    "selected_at": {
      "oneOf": [
        { "type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$" },
        { "type": "null" }
      ]
    },
    "expires_at": {
      "oneOf": [
        { "type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$" },
        { "type": "null" }
      ]
    },
    "approver_role": {
      "oneOf": [
        { "const": "human-release-approver" },
        { "type": "null" }
      ]
    },
    "approver_id": {
      "oneOf": [
        { "type": "string", "minLength": 1, "maxLength": 256 },
        { "type": "null" }
      ]
    },
    "approval_digest": {
      "oneOf": [
        { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        { "type": "null" }
      ]
    },
    "selection_digest": {
      "oneOf": [
        { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        { "type": "null" }
      ]
    },
    "sealed_bundle_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "repeatability_receipt_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "rehearsal_receipt_valid_until": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "backup_readiness_evidence": {
      "type": "string",
      "minLength": 1
    },
    "previous_release_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "expected_release_contexts": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "uniqueItems": true,
      "prefixItems": [
        { "const": "build" },
        { "const": "changes" },
        { "const": "dependency-audit" },
        { "const": "policy" },
        { "const": "quality" },
        { "const": "security-function-authorization" },
        { "const": "security-smoke" }
      ],
      "items": false
    },
    "required_check_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total", "success", "intended_skip"],
      "properties": {
        "total": { "type": "integer", "minimum": 7 },
        "success": { "type": "integer", "minimum": 7 },
        "intended_skip": { "type": "integer", "minimum": 0 },
        "bad": { "const": 0 },
        "cancelled": { "const": 0 },
        "failed": { "const": 0 },
        "pending": { "const": 0 },
        "queued": { "const": 0 },
        "rerun": { "const": 0 }
      }
    },
    "all_check_suite_count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 999
    },
    "all_check_suite_ids_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "all_check_suite_authority_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "Binds check suites sorted by id as exact closed {app_id,app_name,app_slug,head_sha,id,repository} tuples with the canonical repository and exact head SHA."
    },
    "all_actions_workflow_run_provenance_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "all_context_check_run_instances_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "Binds every started check instance, including the exact allowlisted GitGuardian owner, suite repository, head, external ID, and terminal-success evidence."
    },
    "all_context_check_suite_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "integer", "minimum": 1 }
    },
    "all_context_commit_statuses_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "attestation_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "app_launch_agent_enabled": {
      "type": "boolean"
    },
    "full_local_launch_agent_enabled": {
      "type": "boolean"
    },
    "youtube_worker_launch_agent_enabled": {
      "type": "boolean"
    }
  }
}
