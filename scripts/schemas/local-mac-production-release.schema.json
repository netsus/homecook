{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "homecook.local-mac-production-release.v1",
  "title": "Homecook local Mac production release manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "repository",
    "source_ref",
    "signer_workflow",
    "signer_digest",
    "expected_release_integration_id",
    "promotion_id",
    "release_tag",
    "release_manifest_path",
    "release_sha",
    "release_tree",
    "master_sha_at_approval",
    "approved_at",
    "approved_by_task_id",
    "migration_head",
    "build_id",
    "backup_readiness_evidence",
    "previous_release_sha",
    "expected_release_contexts",
    "required_check_summary",
    "attestation_digest",
    "app_launch_agent_enabled",
    "full_local_launch_agent_enabled",
    "youtube_worker_launch_agent_enabled"
  ],
  "properties": {
    "schema": {
      "const": "homecook.local-mac-production-release.v1"
    },
    "repository": {
      "const": "netsus/homecook"
    },
    "source_ref": {
      "const": "refs/heads/master"
    },
    "signer_workflow": {
      "const": "netsus/homecook/.github/workflows/production-release-attestation.yml"
    },
    "signer_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "expected_release_integration_id": {
      "const": 15368
    },
    "promotion_id": {
      "type": "string",
      "minLength": 1
    },
    "release_tag": {
      "type": "string",
      "pattern": "^prod-\\d{8}\\.\\d+$"
    },
    "release_manifest_path": {
      "type": "string",
      "minLength": 1
    },
    "release_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "release_tree": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "master_sha_at_approval": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "approved_at": {
      "type": "string",
      "format": "date-time"
    },
    "approved_by_task_id": {
      "type": "string",
      "minLength": 1
    },
    "migration_head": {
      "type": "string",
      "minLength": 1
    },
    "build_id": {
      "type": "string",
      "minLength": 1
    },
    "backup_readiness_evidence": {
      "type": "string",
      "minLength": 1
    },
    "previous_release_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "expected_release_contexts": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "uniqueItems": true,
      "prefixItems": [
        { "const": "build" },
        { "const": "changes" },
        { "const": "dependency-audit" },
        { "const": "policy" },
        { "const": "quality" },
        { "const": "security-function-authorization" },
        { "const": "security-smoke" },
        { "const": "snyk" }
      ],
      "items": false
    },
    "required_check_summary": {
      "type": "object"
    },
    "attestation_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "app_launch_agent_enabled": {
      "type": "boolean"
    },
    "full_local_launch_agent_enabled": {
      "type": "boolean"
    },
    "youtube_worker_launch_agent_enabled": {
      "type": "boolean"
    }
  }
}
