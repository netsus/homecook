{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "homecook.github.production-release-external-check-evidence.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "all_check_suite_count",
    "all_check_suite_ids_digest",
    "all_context_check_run_instances_digest",
    "all_context_check_suite_ids",
    "all_context_commit_statuses_digest",
    "required_check_summary"
  ],
  "properties": {
    "all_check_suite_count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 999
    },
    "all_check_suite_ids_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "all_context_check_run_instances_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "all_context_check_suite_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "integer", "minimum": 1 }
    },
    "all_context_commit_statuses_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "required_check_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total", "success", "intended_skip", "bad", "cancelled",
        "failed", "pending", "queued", "rerun"
      ],
      "properties": {
        "total": { "type": "integer", "minimum": 0 },
        "success": { "type": "integer", "minimum": 0 },
        "intended_skip": { "type": "integer", "minimum": 0 },
        "bad": { "const": 0 },
        "cancelled": { "const": 0 },
        "failed": { "const": 0 },
        "pending": { "const": 0 },
        "queued": { "const": 0 },
        "rerun": { "const": 0 }
      }
    }
  }
}
