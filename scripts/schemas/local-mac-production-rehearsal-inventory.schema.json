{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "homecook.local-mac-production-rehearsal-inventory.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "canonicalization", "repository", "captured_at", "surface_allowlist_version", "probe_identity", "tool_identities", "production_db_connection_count", "mutation_attempt_count", "redacted_field_count", "surfaces", "surface_digest", "inventory_digest"],
  "properties": {
    "schema": { "const": "homecook.local-mac-production-rehearsal-inventory.v1" },
    "canonicalization": { "const": "RFC8785-JCS+SHA256" },
    "repository": { "const": "netsus/homecook" },
    "captured_at": { "$ref": "#/definitions/timestamp" },
    "surface_allowlist_version": { "const": "homecook-production-surface-v1" },
    "probe_identity": { "$ref": "#/definitions/tool" },
    "tool_identities": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/definitions/namedTool" } },
    "production_db_connection_count": { "const": 0 },
    "mutation_attempt_count": { "const": 0 },
    "redacted_field_count": { "type": "integer", "minimum": 0 },
    "surfaces": { "$ref": "#/definitions/surfaces" },
    "surface_digest": { "$ref": "#/definitions/hex64" },
    "inventory_digest": { "$ref": "#/definitions/hex64" }
  },
  "definitions": {
    "nonempty": { "type": "string", "minLength": 1 },
    "hex40": { "type": ["string", "null"], "pattern": "^[0-9a-f]{40}$" },
    "hex64": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "nullableHex64": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
    "timestamp": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$" },
    "identityInteger": { "oneOf": [{ "type": "integer", "minimum": 0 }, { "type": "string", "pattern": "^(0|[1-9][0-9]*)$" }] },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "realpath", "device", "inode", "mode", "ctime", "size", "sha256"],
      "properties": {
        "version": { "$ref": "#/definitions/nonempty" },
        "realpath": { "type": "string", "pattern": "^/" },
        "device": { "$ref": "#/definitions/identityInteger" },
        "inode": { "$ref": "#/definitions/identityInteger" },
        "mode": { "type": "integer", "minimum": 0 },
        "ctime": { "$ref": "#/definitions/timestamp" },
        "size": { "type": "integer", "minimum": 0 },
        "sha256": { "$ref": "#/definitions/hex64" }
      }
    },
    "namedTool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "realpath", "device", "inode", "mode", "ctime", "size", "sha256"],
      "properties": {
        "name": { "$ref": "#/definitions/nonempty" },
        "version": { "$ref": "#/definitions/nonempty" },
        "realpath": { "type": "string", "pattern": "^/" },
        "device": { "$ref": "#/definitions/identityInteger" },
        "inode": { "$ref": "#/definitions/identityInteger" },
        "mode": { "type": "integer", "minimum": 0 },
        "ctime": { "$ref": "#/definitions/timestamp" },
        "size": { "type": "integer", "minimum": 0 },
        "sha256": { "$ref": "#/definitions/hex64" }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "exists", "device", "inode", "owner_uid", "mode", "size", "mtime", "sha256"],
      "properties": {
        "kind": { "$ref": "#/definitions/nonempty" },
        "exists": { "type": "boolean" },
        "device": { "$ref": "#/definitions/identityInteger" },
        "inode": { "$ref": "#/definitions/identityInteger" },
        "owner_uid": { "type": "integer", "minimum": 0 },
        "mode": { "type": "integer", "minimum": 0 },
        "size": { "type": "integer", "minimum": 0 },
        "mtime": { "$ref": "#/definitions/timestamp" },
        "sha256": { "$ref": "#/definitions/hex64" }
      }
    },
    "workload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["component", "release_sha", "release_tree", "build_id", "sealed_bundle_digest", "health", "descriptor_digest"],
      "properties": {
        "component": { "$ref": "#/definitions/nonempty" },
        "release_sha": { "$ref": "#/definitions/hex40" },
        "release_tree": { "$ref": "#/definitions/hex40" },
        "build_id": { "type": ["string", "null"], "minLength": 1 },
        "sealed_bundle_digest": { "$ref": "#/definitions/nullableHex64" },
        "health": { "enum": ["running", "partial", "stopped", "missing", "unknown"] },
        "descriptor_digest": { "$ref": "#/definitions/nullableHex64" }
      }
    },
    "launchd": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "loaded", "state", "pid", "projection_digest"],
      "properties": {
        "label": { "$ref": "#/definitions/nonempty" },
        "loaded": { "type": "boolean" },
        "state": { "$ref": "#/definitions/nonempty" },
        "pid": { "type": ["integer", "null"], "minimum": 1 },
        "projection_digest": { "$ref": "#/definitions/hex64" }
      }
    },
    "container": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "name", "project", "service", "image_digest", "state", "generation_digest"],
      "properties": {
        "id": { "$ref": "#/definitions/nonempty" }, "name": { "$ref": "#/definitions/nonempty" },
        "project": { "type": "string" }, "service": { "type": "string" }, "image_digest": { "$ref": "#/definitions/nonempty" },
        "state": { "$ref": "#/definitions/nonempty" }, "generation_digest": { "$ref": "#/definitions/hex64" }
      }
    },
    "network": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "name", "project", "generation_digest"],
      "properties": { "id": { "$ref": "#/definitions/nonempty" }, "name": { "$ref": "#/definitions/nonempty" }, "project": { "type": "string" }, "generation_digest": { "$ref": "#/definitions/hex64" } }
    },
    "volume": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "project", "service", "generation_digest"],
      "properties": { "name": { "$ref": "#/definitions/nonempty" }, "project": { "type": "string" }, "service": { "type": "string" }, "generation_digest": { "$ref": "#/definitions/hex64" } }
    },
    "port": {
      "type": "object", "additionalProperties": false,
      "required": ["port", "pid", "process_name", "listener_digest"],
      "properties": { "port": { "type": "integer", "minimum": 1, "maximum": 65535 }, "pid": { "type": ["integer", "null"], "minimum": 1 }, "process_name": { "$ref": "#/definitions/nonempty" }, "listener_digest": { "$ref": "#/definitions/hex64" } }
    },
    "config": {
      "type": "object", "additionalProperties": false,
      "required": ["identity", "sha256"],
      "properties": { "identity": { "$ref": "#/definitions/nonempty" }, "sha256": { "$ref": "#/definitions/hex64" } }
    },
    "migration": {
      "type": "object", "additionalProperties": false,
      "required": ["approved", "marker_digest", "global_ledger_digest", "catalog_head"],
      "properties": { "approved": { "type": "boolean" }, "marker_digest": { "$ref": "#/definitions/nullableHex64" }, "global_ledger_digest": { "$ref": "#/definitions/nullableHex64" }, "catalog_head": { "type": ["string", "null"], "minLength": 1 } }
    },
    "surfaces": {
      "type": "object", "additionalProperties": false,
      "required": ["release_artifacts", "workloads", "launchd", "docker", "port_listeners", "opaque_configs", "migration"],
      "properties": {
        "release_artifacts": { "type": "array", "items": { "$ref": "#/definitions/artifact" } },
        "workloads": { "type": "array", "items": { "$ref": "#/definitions/workload" } },
        "launchd": { "type": "array", "items": { "$ref": "#/definitions/launchd" } },
        "docker": {
          "type": "object", "additionalProperties": false, "required": ["containers", "networks", "volumes"],
          "properties": { "containers": { "type": "array", "items": { "$ref": "#/definitions/container" } }, "networks": { "type": "array", "items": { "$ref": "#/definitions/network" } }, "volumes": { "type": "array", "items": { "$ref": "#/definitions/volume" } } }
        },
        "port_listeners": { "type": "array", "items": { "$ref": "#/definitions/port" } },
        "opaque_configs": { "type": "array", "items": { "$ref": "#/definitions/config" } },
        "migration": { "$ref": "#/definitions/migration" }
      }
    }
  }
}
