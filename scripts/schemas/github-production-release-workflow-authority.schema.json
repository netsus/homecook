{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "homecook.github.production-release-workflow-authority.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "workflow_head_sha",
    "workflow_head_tree",
    "workflow_run_id",
    "workflow_run_attempt",
    "workflow_check_suite_id"
  ],
  "properties": {
    "workflow_head_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "workflow_head_tree": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "workflow_run_id": { "type": "integer", "minimum": 1 },
    "workflow_run_attempt": { "const": 1 },
    "workflow_check_suite_id": { "type": "integer", "minimum": 1 }
  }
}
