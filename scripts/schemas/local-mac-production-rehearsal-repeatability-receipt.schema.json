{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "homecook.local-mac-production-rehearsal-repeatability-receipt.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "canonicalization", "repository", "source_ref", "release_sha", "release_tree", "build_id", "sealed_bundle_digest", "member_receipt_digests", "member_run_ids", "member_resource_identity_digests", "toolchain_digest", "image_set_digest", "migration_ledger_digest", "canary_set_digest", "cleanup_evidence_digests", "production_guard_digests", "completed_at", "valid_until", "status", "issuer_task_id", "repeatability_receipt_digest"],
  "properties": {
    "schema": { "const": "homecook.local-mac-production-rehearsal-repeatability-receipt.v1" },
    "canonicalization": { "const": "RFC8785-JCS+SHA256" },
    "repository": { "const": "netsus/homecook" },
    "source_ref": { "const": "refs/heads/master" },
    "release_sha": { "$ref": "#/definitions/hex40" },
    "release_tree": { "$ref": "#/definitions/hex40" },
    "build_id": { "$ref": "#/definitions/nonempty" },
    "sealed_bundle_digest": { "$ref": "#/definitions/hex64" },
    "member_receipt_digests": { "$ref": "#/definitions/twoHex64" },
    "member_run_ids": { "$ref": "#/definitions/twoStrings" },
    "member_resource_identity_digests": { "$ref": "#/definitions/twoHex64" },
    "toolchain_digest": { "$ref": "#/definitions/hex64" },
    "image_set_digest": { "$ref": "#/definitions/hex64" },
    "migration_ledger_digest": { "$ref": "#/definitions/hex64" },
    "canary_set_digest": { "$ref": "#/definitions/hex64" },
    "cleanup_evidence_digests": { "$ref": "#/definitions/twoHex64AllowDuplicates" },
    "production_guard_digests": { "$ref": "#/definitions/twoHex64AllowDuplicates" },
    "completed_at": { "$ref": "#/definitions/timestamp" },
    "valid_until": { "$ref": "#/definitions/timestamp" },
    "status": { "const": "repeatable" },
    "issuer_task_id": { "$ref": "#/definitions/nonempty" },
    "repeatability_receipt_digest": { "$ref": "#/definitions/hex64" }
  },
  "definitions": {
    "nonempty": { "type": "string", "minLength": 1 },
    "hex40": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "hex64": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "timestamp": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$" },
    "twoHex64": { "type": "array", "minItems": 2, "maxItems": 2, "uniqueItems": true, "items": { "$ref": "#/definitions/hex64" } },
    "twoHex64AllowDuplicates": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "$ref": "#/definitions/hex64" } },
    "twoStrings": { "type": "array", "minItems": 2, "maxItems": 2, "uniqueItems": true, "items": { "$ref": "#/definitions/nonempty" } }
  }
}
