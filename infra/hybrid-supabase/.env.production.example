# Copy to .env.production.local, fill only non-secret values, then:
# chmod 600 infra/hybrid-supabase/.env.production.local
#
# Secrets MUST NOT be added to this file. The default source is macOS Keychain.
# Store one generic-password item per account name listed in PRODUCTION_RUNBOOK.md.

AUTH_SUPABASE_URL=https://your-project.supabase.co
AUTH_SUPABASE_EXPECTED_ISSUER=https://your-project.supabase.co/auth/v1
AUTH_SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json
HOMECOOK_DATA_AUTHORITY=remote

HOMECOOK_HYBRID_GATEWAY_PORT=54381
HYBRID_COMPOSE_PROJECT_NAME=homecook-hybrid-production
# Apple Silicon: linux/arm64. Intel Mac: linux/amd64.
HYBRID_DOCKER_PLATFORM=linux/arm64
# Reviewed platform-specific manifest digests. For Intel values, use the
# exact linux/amd64 table in PRODUCTION_RUNBOOK.md; do not substitute tags.
HYBRID_POSTGRES_IMAGE=public.ecr.aws/supabase/postgres@sha256:a9946f08d31e8eb1149229c94e5c26603a9233116807cbbd93d75179cbac516a
HYBRID_POSTGREST_IMAGE=postgrest/postgrest@sha256:844785450d6b046ee97f1c67ea37e3ff6b4ed7ee3570b1b91c03f66f032c4805
HYBRID_STORAGE_IMAGE=supabase/storage-api@sha256:9326eb9c6b74c0a5ba393ab46a08a51d16bc5ea5f2978fc5b0f17fc67c64a4de
HYBRID_NODE_IMAGE=docker.io/library/node@sha256:74e144386aaec923ce092c3371b351d96c4f977a4ac3f58431fa9164b9399534
HYBRID_POSTGRES_DB=homecook
HYBRID_POSTGRES_VOLUME_NAME=homecook-hybrid-production-postgres
HYBRID_STORAGE_VOLUME_NAME=homecook-hybrid-production-storage
HYBRID_STORAGE_FILE_SIZE_LIMIT=52428800
HYBRID_STORAGE_GLOBAL_BUCKET=homecook-hybrid
HYBRID_STORAGE_TENANT_ID=homecook-hybrid
HYBRID_GATEWAY_TIMEOUT_MS=3000

HOMECOOK_HYBRID_SECRET_SOURCE=keychain
HOMECOOK_HYBRID_KEYCHAIN_SERVICE=homecook-hybrid-production
HOMECOOK_HYBRID_BACKUP_KEY_ID=homecook-hybrid-backup-v1
