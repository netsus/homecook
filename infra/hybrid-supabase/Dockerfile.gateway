FROM public.ecr.aws/docker/library/node:22.20.0-alpine

WORKDIR /workspace
COPY infra/hybrid-supabase/loopback-gateway.mjs infra/hybrid-supabase/loopback-gateway.mjs
COPY lib/server/hybrid-auth/public-read-policy-runtime.mjs lib/server/hybrid-auth/public-read-policy-runtime.mjs

USER node
CMD ["node", "infra/hybrid-supabase/loopback-gateway.mjs"]
