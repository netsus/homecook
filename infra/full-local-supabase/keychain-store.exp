#!/usr/bin/expect -f
set timeout 30

if {$argc != 3} {
  puts stderr "Usage: keychain-store.exp <service> <account> <secret-file>"
  exit 64
}

set service [lindex $argv 0]
set account [lindex $argv 1]
set secret_path [lindex $argv 2]
set handle [open $secret_path r]
fconfigure $handle -translation binary
set secret [read $handle]
close $handle

spawn -noecho /usr/bin/security add-generic-password -U -s $service -a $account -w
expect {
  -re {password data for new item:} {
    send -- "$secret\r"
    expect -re {retype password for new item:}
    send -- "$secret\r"
    expect eof
  }
  eof
  timeout {
    puts stderr "Keychain password prompt timed out."
    exit 70
  }
}
set result [wait]
exit [lindex $result 3]
