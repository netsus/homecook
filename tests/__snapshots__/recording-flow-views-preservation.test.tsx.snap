exports[`preserves the full legacy result-to-done markup and original action order > experience-1 1`] = `"<main class="mdv2-screen screen-content demo-screen" data-stage="experience-1" data-testid="screen-experience-1"><div class="unified-progress-header"><button class="icon-button back-button" type="button" aria-label="이전 화면"><svg width="15" height="15" viewBox="0 0 15 15" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M8.84182 3.13514C9.04327 3.32401 9.05348 3.64042 8.86462 3.84188L5.43521 7.49991L8.86462 11.1579C9.05348 11.3594 9.04327 11.6758 8.84182 11.8647C8.64036 12.0535 8.32394 12.0433 8.13508 11.8419L4.38508 7.84188C4.20477 7.64955 4.20477 7.35027 4.38508 7.15794L8.13508 3.15794C8.32394 2.95648 8.64036 2.94628 8.84182 3.13514Z" fill="currentColor" fill-rule="evenodd" clip-rule="evenodd"></path></svg></button><div class="unified-progress-segments" role="progressbar" aria-valuemin="1" aria-valuemax="5" aria-valuenow="1" aria-label="체험 1 / 5 · 레시피 가져오기"><span class="is-current"></span><span class=""></span><span class=""></span><span class=""></span><span class=""></span></div><span class="unified-progress-count"><strong>1</strong> / 5</span></div><div class="demo-title"><h1 class="recipe-import-title " data-state="idle" aria-label="유튜브 레시피를 가져올게요.">유튜브 레시피를 <span>가져올게요.</span></h1></div><div class="recipe-card "><div class="recipe-media"><img alt="유튜브 제육볶음 레시피 썸네일" width="480" height="360" decoding="async" data-nimg="1" class="recipe-thumbnail" style="color: transparent;" src="/assets/funnel/food/recipe-jeyuk-thumbnail.webp"><span class="youtube-play" aria-hidden="true"><svg width="15" height="15" viewBox="0 0 15 15" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M3.24182 2.32181C3.3919 2.23132 3.5784 2.22601 3.73338 2.30781L12.7334 7.05781C12.8974 7.14436 13 7.31457 13 7.5C13 7.68543 12.8974 7.85564 12.7334 7.94219L3.73338 12.6922C3.5784 12.774 3.3919 12.7687 3.24182 12.6782C3.09175 12.5877 3 12.4252 3 12.25V2.75C3 2.57476 3.09175 2.4123 3.